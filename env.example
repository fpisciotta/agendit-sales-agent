# Agendit Sales Agent — variables de entorno
# Copiá este archivo a .env y completá los valores. .env NUNCA va a git.

# --- Proveedor de IA ---
# gemini | claude. Un valor no reconocido corta el arranque.
AI_PROVIDER=gemini
# Techo de tokens de salida. En los modelos que razonan cubre thinking +
# respuesta: si lo dejás corto, el razonamiento se come el presupuesto y la
# respuesta sale truncada. 3000 da margen para una respuesta de WhatsApp.
AI_MAX_TOKENS=3000
# Intentos totales por request, incluido el primero. Absorbe los 503
# ("high demand") que tiran los modelos flash en los picos.
AI_INTENTOS=3

# --- Gemini (si AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Razonamiento (equivale al effort de Claude). Elegí UNA de las dos:
#   GEMINI_THINKING_LEVEL: low | medium | high  ← forma nueva, la de los 3.x
#   GEMINI_THINKING_BUDGET: tokens, o -1 dinámico  ← forma vieja
# Sin ninguna definida, el modelo decide.
# OJO: budget=0 desactivaba el razonamiento en los 2.5, pero los 3.x razonan
# siempre y devuelven 400. Para baja latencia usá THINKING_LEVEL=low.
GEMINI_THINKING_LEVEL=low

# --- Claude (si AI_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Esfuerzo del modelo: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low

# --- Meta WhatsApp Cloud API ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=agendit-verify-2026
META_API_VERSION=v25.0

# --- Servidor ---
PORT=8000
NODE_ENV=development

# --- Base de datos ---
# SQLite, en desarrollo y en produccion. Necesita disco persistente: si
# deployas en una plataforma con filesystem efimero, monta un volumen y
# apunta SQLITE_PATH adentro.
SQLITE_PATH=./agendit-sales-agent.db
# Solo si algun dia migras a Postgres:
# DATABASE_URL=postgresql://usuario:pass@host:5432/db

# --- Comportamiento ---
# true: el agente solo responde a números que llegaron por publicidad paga.
# Ponelo en false para poder probar desde tu propio celular.
SOLO_LEADS_PUBLICIDAD=true

# Frases que hacen que el agente atienda aunque Meta no marque el número como
# lead de publicidad. Son los mensajes que genera un botón de WhatsApp en la web
# o en un anuncio. Varias frases separadas por "|".
# La comparación ignora tildes, mayúsculas y signos, y alcanza con que el
# mensaje CONTENGA la frase.
MENSAJES_DE_ENTRADA=hola me interesa saber mas sobre agendit

# --- Aviso al equipo cuando se deriva una conversación ---
# Números que reciben el aviso, en E.164 sin "+", separados por coma.
# Dejalo vacío para desactivar la notificación.
NUMEROS_NOTIFICACION=595972511222,595984489269
# Plantilla aprobada. Recibe el número del cliente como único parámetro del body.
PLANTILLA_NOTIFICACION=sales_agent_notification
PLANTILLA_NOTIFICACION_IDIOMA=es

# Carpeta de business.yaml y prompts.yaml (por defecto ./config)
# CONFIG_DIR=./config

# --- Recontacto automatico ---
# El agente vuelve a escribir a los clientes que no respondieron.
RECONTACTO_ACTIVO=true
# Horas de silencio antes de recontactar
RECONTACTO_HORAS=1
# Techo de silencio. Existe por la ventana de 24h de WhatsApp: pasada esa
# ventana un texto libre se acepta pero NO se entrega.
RECONTACTO_VENTANA_HORAS=23
# Tope de recontactos por corrida, para no vaciar la cuota del modelo
RECONTACTO_MAX_POR_CORRIDA=20

# --- Google Calendar (agenda las demos) ---
# Service Account con delegacion de dominio en Google Workspace.
# Dejar vacio desactiva la funcion: el agente pide los datos igual pero no agenda.
# El JSON completo de la clave, o la ruta al archivo:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Persona del dominio que queda como organizadora del evento:
GOOGLE_IMPERSONATE_EMAIL=
# Calendario donde se crean las demos ("primary" es el de esa persona):
GOOGLE_CALENDAR_ID=primary
# Franjas en las que se dan demos, hora de Paraguay. Varias separadas por coma;
# el hueco del mediodia es el almuerzo. Acepta "10" o "10:30".
DEMO_FRANJAS=10-12,13-17
# Duracion de cada demo, y paso con el que se ofrecen horarios alternativos:
DEMO_DURACION_MIN=30
# Anticipacion minima para una demo de HOY, en minutos. Evita que un cliente
# agende para dentro de 2 minutos y agarre al equipo desprevenido.
DEMO_ANTICIPACION_MIN=30
# Solo de lunes a viernes: no es configurable, esta fijo en el codigo.
